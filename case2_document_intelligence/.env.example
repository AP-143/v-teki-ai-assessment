# Key clients must send in the X-API-Key header. Set it in your shell; never commit the real value.
INVOICE_API_KEY=replace-with-a-long-random-secret
# Optional: local Ollama endpoint and model (defaults shown). External endpoints are refused
# unless ALLOW_EXTERNAL_LLM=true is set after the data transfer has been approved.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
